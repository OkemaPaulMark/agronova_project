flutter_app/ios/Pods/
flutter_app/ios/.symlinks/
flutter_app/ios/Flutter/Flutter.framework/
flutter_app/macos/Flutter/Flutter.framework/
flutter_app/web/.dart_tool/

# VSCode and JetBrains IDE
.vscode/
.idea/
